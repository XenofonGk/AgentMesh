# AgentMesh — copy to `.env` and fill in. `.env` is gitignored and must stay that way.
#
# Nothing in this file is a provider API key. Provider credentials are never configured
# through the environment: users add them in the app, they are encrypted at rest by the
# vault, and only the credential proxy ever holds a decrypted one — in memory, for the
# life of a single request. See SECURITY.md.

# --- Postgres -----------------------------------------------------------------------
# Generate a real value, do not ship this one:  openssl rand -base64 32
POSTGRES_PASSWORD=change-me-before-first-run
POSTGRES_USER=agentmesh
POSTGRES_DB=agentmesh
# Host-side port. Published on 127.0.0.1 only.
POSTGRES_PORT=5432

# --- API ----------------------------------------------------------------------------
API_PORT=3001
LOG_LEVEL=info
# Exact browser origin permitted to call the API. No wildcards.
WEB_ORIGIN=http://localhost:3000
# The credential proxy, reachable only over the `internal` Docker network — never the
# host. Default matches compose.yaml's service name; only override for local dev.
# PROXY_URL=http://proxy:3002

# --- Web ----------------------------------------------------------------------------
WEB_PORT=3000
# Baked into the browser bundle at build time — must be a URL the *browser* can reach.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Vault (required) ---------------------------------------------------------------
# The key that wraps every user's data-encryption key. 32 bytes, base64.
# Generate with:  openssl rand -base64 32
# The value below is a placeholder and is rejected at startup on purpose, so an instance
# can never run on a key that was copied out of this file. Set one or the other:
#   VAULT_MASTER_KEY       the key itself
#   VAULT_MASTER_KEY_FILE  a path to a file containing it (for Docker/Podman secrets)
VAULT_MASTER_KEY=REPLACE_ME_RUN_openssl_rand_base64_32
# Increment only when rotating. Both versions' canaries coexist during a rotation.
# VAULT_MASTER_KEY_VERSION=1

# --- Admin account (required) --------------------------------------------------------
# Phase 1 has no signup flow — this is the only way to get a working login. Seeded once
# on first boot; changing these after that has no effect (see SECURITY.md). At least
# 12 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_ME_RUN_openssl_rand_base64_18
