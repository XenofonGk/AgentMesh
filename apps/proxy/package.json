{
  "name": "@agentmesh/proxy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -b",
    "start": "node dist/main.js",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@agentmesh/core": "workspace:*",
    "@agentmesh/db": "workspace:*",
    "fastify": "^5.11.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  }
}
