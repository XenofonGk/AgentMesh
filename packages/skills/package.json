{
  "name": "@agentmesh/skills",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "default": "./dist/parser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@agentmesh/core": "workspace:*",
    "yaml": "^2.6.1",
    "zod": "^3.25.76"
  }
}
